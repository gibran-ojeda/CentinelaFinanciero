# Centinela Financiero — plantilla de configuración.
#
# Copiar a `.env` y rellenar. `.env` está en .gitignore: nunca se versiona.
#   cp .env.example .env
#
# Este archivo se mantiene al día en cada fase que añada variables.

# ─── Entorno ──────────────────────────────────────────────────
# dev | prod | test
ENVIRONMENT=dev
APP_NAME=centinela-financiero

# ─── PostgreSQL ───────────────────────────────────────────────
# Puerto 5433 (no 5432): en el VPS convive con el Postgres de NarrativeAlpha.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=centinela
POSTGRES_USER=centinela
POSTGRES_PASSWORD=cambiame
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ─── Redis ────────────────────────────────────────────────────
# Puerto 6380 por la misma razón que el 5433.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=3.0

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# json | pretty. Vacío = json en prod, pretty en dev.
LOG_FORMAT=
# Claves cuyo valor se redacta en los logs (coincidencia por substring).
LOG_SENSITIVE_PATTERNS=password,secret,token,api_key,apikey,authorization

# ─── API ──────────────────────────────────────────────────────
# La API nunca se expone a internet: sólo la consumen el BFF y el admin.
API_HOST=0.0.0.0
API_PORT=8000
# Llave de lectura (la usa el BFF de Astro) y de escritura (admin). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_READ_KEY=
API_ADMIN_KEY=
# Orígenes CORS separados por coma. Vacío = sin CORS (el BFF llama server-side).
API_CORS_ORIGINS=

# ─── Frontend público (servicio `web`) ────────────────────────
# Origen público del sitio: alimenta la URL canónica, el sitemap y el robots.
# Sin prefijo PUBLIC_ a propósito — Vite sustituye esas variables en el build y
# el dominio no se conoce hasta que arranca el contenedor, así que se lee en
# cada petición. **Obligatoria en producción**, o el sitio se anuncia a los
# buscadores con la URL del loopback.
SITE_URL=http://127.0.0.1:8011
API_TIMEOUT_SECONDS=10

# ─── Scheduler ────────────────────────────────────────────────
# Gate frío: decide si el job se registra. El kill-switch caliente vive en
# ConfigStore (fase 2) y apaga el job sin reiniciar el proceso.
SCHEDULER_HEARTBEAT_ENABLED=true
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=60
# Recomputo diario de banderas de riesgo. Su kill-switch caliente es
# BANDERAS_RECOMPUTE_ENABLED en el ConfigStore.
SCHEDULER_BANDERAS_ENABLED=true
# Lectura semanal de tasas (lunes 06:00). Éste decide si el job se **registra**;
# para apagarlo sin reiniciar está su kill-switch caliente en el ConfigStore:
#   python -m cli config set tasas_fetch_enabled false --motivo "..."
SCHEDULER_TASAS_ENABLED=true
SCHEDULER_LOCK_TTL_SECONDS=300
SCHEDULER_TIMEZONE=America/Mexico_City

# ─── Parámetros de negocio (defaults) ─────────────────────────
# Son los valores por defecto. El ConfigStore (tabla config_store) los
# sobrescribe en caliente, con historial auditable:
#   python -m cli config set umbral_imor_roja 5.5 --motivo "..."
#   python -m cli config list
# Descomentar aquí sólo para cambiar el default de arranque.

# Banderas individuales (§5.1 del foundation)
# UMBRAL_IMOR_AMARILLA=3.0
# UMBRAL_IMOR_ROJA=6.0
# UMBRAL_ICAP_AMARILLA=15.0
# UMBRAL_ICAP_ROJA=10.5
# UMBRAL_COBERTURA_AMARILLA=100.0
# UMBRAL_COBERTURA_ROJA=70.0

# Banderas compuestas (§5.2)
# UMBRAL_GAT_INCONSISTENCIA_PP=1.5
# UMBRAL_CRECIMIENTO_CAPTACION_PCT=50.0
# UMBRAL_TASA_SOBRE_MERCADO_PP=3.0
# UMBRAL_APALANCAMIENTO_AMARILLA=10.0

# Respaldo de último recurso, sólo si la tabla valores_serie está vacía.
# Valores reales del SIE de Banxico al 2026-07-25.
# UDI_VALOR_FALLBACK=8.791497
# INFLACION_ANUAL_FALLBACK=3.37

# Operación
# TOLERANCIA_REVISION_PP=0.5

# Publica las instituciones ilustrativas (◆) y las tasas que siguen en
# PENDIENTE_REVISION, siempre marcadas como tales en la respuesta y en la UI.
# Viene encendido para que un entorno recién levantado no parezca vacío.
#   *** PONER EN false ANTES DE EXPONER EL SITIO A INTERNET (fase 6) ***
# MOSTRAR_DATOS_DEMO=true

# CACHE_COMPARADOR_TTL_SECONDS=300
# BANDERAS_RECOMPUTE_ENABLED=true
# CONFIG_CACHE_TTL_SECONDS=60

# Kill-switch caliente de la lectura de tasas, y el que decide si el job del VPS
# se limita a las fuentes que rinden sin navegador. Está en `true` mientras
# Chromium no esté en la imagen del scheduler; las once fuentes que necesitan
# JavaScript se corren desde local con `cli tasas fetch --solo-navegador`.
# Ver «Navegador en el VPS» en docs/despliegue.md.
# TASAS_FETCH_ENABLED=true
# TASAS_FETCH_SOLO_SIN_JS=true

# ─── Fuentes de datos ─────────────────────────────────────────
# Banxico SIE (fase 7): series CETES, UDI, INPC, TIIE, FIX.
# Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# DeepSeek (fase 9): extracción y research de tasas sin API oficial.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.deepseek.com/v1
# Modelo de extracción. NO usar razonadores: gastan el presupuesto de tokens
# pensando y devuelven el contenido vacío. `deepseek-chat` y `deepseek-reasoner`
# los retiró DeepSeek el 2026-07-24.
# LLM_MODELO_EXTRACCION=deepseek-v4-flash
# LLM_TIMEOUT_SECONDS=90
# Techo duro de gasto diario (D2). Es una red contra bucles, no un presupuesto:
# lo esperado son centavos por semana.
# LLM_COST_DAILY_LIMIT_USD=1.0

# ─── Descarga de páginas de tasas ─────────────────────────────
# El bot se identifica y dice dónde reclamar. No se imita un navegador para
# esquivar un WAF: si una institución bloquea a un bot identificado, esa fuente
# pasa a lectura manual. FETCH_RESPETAR_ROBOTS no se pone en false.
# FETCH_USER_AGENT=Mozilla/5.0 (compatible; CentinelaFinancieroBot/1.0; +https://centinelafinanciero.lat/aviso-legal)
# FETCH_RESPETAR_ROBOTS=true
# FETCH_TIMEOUT_SECONDS=20

# Las cuatro capas de resiliencia. Los valores vienen de NarrativeAlpha, donde
# están calibrados en producción — no reducir sin medir.
#   · Reintentos ADEMÁS del intento inicial, y sólo ante errores que el tiempo
#     puede curar (408, 425, 429, 5xx). Un 403 es una decisión, no congestión.
# FETCH_MAX_REINTENTOS=1
#   · Errores duros por host antes de dejarlo para la siguiente corrida.
# FETCH_UMBRAL_CIRCUITO=2
#   · Backoff temporal cuando la cadena se degrada por algo transitorio: cinco
#     minutos y luego veinte. La CLI usa una espera corta aparte para no dejar
#     una terminal colgada media hora.
# FETCH_ESPERAS_BACKOFF_S=[300.0, 1200.0]
#   · Menos texto que esto es una página que no se pudo leer, no una sin tasas.
#     La distinción sostiene el circuito: vacío ≠ error duro.
# FETCH_MIN_CARACTERES=200
