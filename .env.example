# Centinela Financiero — plantilla de configuración.
#
# Copiar a `.env` y rellenar. `.env` está en .gitignore: nunca se versiona.
#   cp .env.example .env
#
# Este archivo se mantiene al día en cada fase que añada variables.

# ─── Entorno ──────────────────────────────────────────────────
# dev | prod | test
ENVIRONMENT=dev
APP_NAME=centinela-financiero

# ─── PostgreSQL ───────────────────────────────────────────────
# Puerto 5433 (no 5432): en el VPS otro stack ya ocupa el puerto estándar.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=centinela
POSTGRES_USER=centinela
POSTGRES_PASSWORD=cambiame
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ─── Redis ────────────────────────────────────────────────────
# Puerto 6380 por la misma razón que el 5433.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=3.0

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# json | pretty. Vacío = json en prod, pretty en dev.
LOG_FORMAT=
# Claves cuyo valor se redacta en los logs (coincidencia por substring).
LOG_SENSITIVE_PATTERNS=password,secret,token,api_key,apikey,authorization

# ─── API ──────────────────────────────────────────────────────
# La API nunca se expone a internet: sólo la consumen el BFF y el admin.
API_HOST=0.0.0.0
API_PORT=8000
# Llave de lectura (la usa el BFF de Astro) y de escritura (admin). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_READ_KEY=
API_ADMIN_KEY=
# Orígenes CORS separados por coma. Vacío = sin CORS (el BFF llama server-side).
API_CORS_ORIGINS=

# ─── Frontend público (servicio `web`) ────────────────────────
# Origen público del sitio: alimenta la URL canónica, el sitemap y el robots.
# Sin prefijo PUBLIC_ a propósito — Vite sustituye esas variables en el build y
# el dominio no se conoce hasta que arranca el contenedor, así que se lee en
# cada petición. **Obligatoria en producción**, o el sitio se anuncia a los
# buscadores con la URL del loopback.
SITE_URL=http://127.0.0.1:8011
API_TIMEOUT_SECONDS=10

# ─── Scheduler ────────────────────────────────────────────────
# Gate frío: decide si el job se registra. El kill-switch caliente vive en
# ConfigStore (fase 2) y apaga el job sin reiniciar el proceso.
#
# ** En producción, este archivo no basta. ** El compose no declara `env_file`:
# una variable sólo llega al contenedor si está en el mapa `environment:` de su
# servicio en docker-compose.yml. Los seis gates del scheduler ya están; una
# variable nueva exige tocar el secreto en GitHub, la plantilla de
# scripts/lib/entorno.sh —con su clase, que decide quién gana si el valor de
# GitHub y el de la máquina difieren— y el mapa del compose.
SCHEDULER_HEARTBEAT_ENABLED=true
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=60
# Recomputo diario de banderas de riesgo. Su kill-switch caliente es
# BANDERAS_RECOMPUTE_ENABLED en el ConfigStore.
SCHEDULER_BANDERAS_ENABLED=true
# Lectura de tasas cada 4 horas (rejilla ..:45; el cortocircuito por hash hace
# gratis las corridas sin cambios). Éste decide si el job se **registra**;
# para apagarlo sin reiniciar está su kill-switch caliente en el ConfigStore:
#   python -m cli config set tasas_fetch_enabled false --motivo "..."
SCHEDULER_TASAS_ENABLED=true
# Sincronización diaria con el SIE de Banxico (07:00). Su kill-switch caliente
# es BANXICO_SYNC_ENABLED en el ConfigStore. Necesita BANXICO_TOKEN, más abajo.
SCHEDULER_BANXICO_ENABLED=true
# Ingesta de boletines de la CNBV (05:30 diario). Diario y no mensual porque la
# CNBV publica con uno a tres meses de rezago y sin fecha fija: el job pregunta
# qué hay, y si no hay nada nuevo no descarga nada. Kill-switch caliente:
# CNBV_INGESTA_ENABLED en el ConfigStore.
SCHEDULER_CNBV_ENABLED=true
# Vigilancia de frescura por fuente (08:00 diario). Sólo mira y reporta.
SCHEDULER_FRESCURA_ENABLED=true
# Búsqueda abierta con agente (nivel 3, cada 4 horas en ..:15 — media hora
# después de cada fetch dirigido, y con cada institución investigada una vez
# al día como mucho). Encendido: sus guardas son el techo de gasto diario
# (LLM_COST_DAILY_LIMIT_USD), el kill-switch caliente `tasas_research_enabled`
# y la calibración automática (`cli research reporte`). En prod, el apagado de
# emergencia es la variable de repo SCHEDULER_RESEARCH_ENABLED=false.
SCHEDULER_RESEARCH_ENABLED=true
SCHEDULER_LOCK_TTL_SECONDS=300
SCHEDULER_TIMEZONE=America/Mexico_City

# ─── Parámetros de negocio (defaults) ─────────────────────────
# Son los valores por defecto. El ConfigStore (tabla config_store) los
# sobrescribe en caliente, con historial auditable:
#   python -m cli config set umbral_imor_roja 5.5 --motivo "..."
#   python -m cli config list
# Descomentar aquí sólo para cambiar el default de arranque.

# Banderas individuales (§5.1 del foundation)
# UMBRAL_IMOR_AMARILLA=3.0
# UMBRAL_IMOR_ROJA=6.0
# UMBRAL_ICAP_AMARILLA=15.0
# UMBRAL_ICAP_ROJA=10.5
# UMBRAL_COBERTURA_AMARILLA=100.0
# UMBRAL_COBERTURA_ROJA=70.0

# Banderas compuestas (§5.2)
# UMBRAL_GAT_INCONSISTENCIA_PP=1.5
# UMBRAL_CRECIMIENTO_CAPTACION_PCT=50.0
# UMBRAL_TASA_SOBRE_MERCADO_PP=3.0
# UMBRAL_APALANCAMIENTO_AMARILLA=10.0

# Respaldo de último recurso, sólo si la tabla valores_serie está vacía.
# Valores reales del SIE de Banxico al 2026-07-25.
# UDI_VALOR_FALLBACK=8.791497
# INFLACION_ANUAL_FALLBACK=3.37

# Operación
# TOLERANCIA_REVISION_PP=0.5

# Publica las tasas que siguen en PENDIENTE_REVISION, siempre marcadas «sin
# verificar» en la respuesta y en la UI. Es la política de transición del
# lanzamiento: se muestran etiquetadas hasta que la lectura oficial de cada
# producto las sustituye. Se apaga sin deploy con
# `cli config set mostrar_tasas_sin_verificar false`.
# MOSTRAR_TASAS_SIN_VERIFICAR=true

# CACHE_COMPARADOR_TTL_SECONDS=300
# BANDERAS_RECOMPUTE_ENABLED=true
# CONFIG_CACHE_TTL_SECONDS=60

# Kill-switch caliente de la lectura de tasas, y el repliegue del navegador:
# Chromium vive en la imagen y el job de tasas (cada 4 horas) lee las
# dieciocho fuentes; poner TASAS_FETCH_SOLO_SIN_JS en true lo devuelve a
# solo-httpx y a las fuentes sin JavaScript, sin deploy (p. ej. si la RAM del
# VPS protesta). Ver «Navegador en el VPS» en docs/despliegue.md.
# TASAS_FETCH_ENABLED=true
# TASAS_FETCH_SOLO_SIN_JS=false
# Techo de duración de esa corrida, en minutos. Al superarlo se corta y lo que
# quede sin leer se lee dentro de 4 horas. Sin esto no hay ningún tope: el lock
# de Redis caduca a los 60 minutos sin cancelar nada.
# TASAS_FETCH_MINUTOS_MAX=20

# Kill-switch caliente de la sincronización con Banxico. Sin BANXICO_TOKEN el
# job se omite de todas formas, así que esto es para apagarla teniéndolo.
# BANXICO_SYNC_ENABLED=true
# CNBV_INGESTA_ENABLED=true
# TASAS_RESEARCH_ENABLED=true

# ─── Fuentes de datos ─────────────────────────────────────────
# Banxico SIE (fase 7): series CETES, UDI, INPC, TIIE, FIX.
# Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
#
# Sin él, `banxico_sync_series` se marca OMITIDO y el sistema sigue con los
# valores de respaldo de UDI e inflación. Con él, esos dos números pasan a ser
# los que Banxico publica y las tasas de CETES se actualizan solas.
BANXICO_TOKEN=
# BANXICO_TIMEOUT_SECONDS=30
# Reintentos ADEMÁS del intento inicial, sólo ante 429 y 5xx.
# BANXICO_MAX_REINTENTOS=2

# DeepSeek (fase 9): extracción y research de tasas sin API oficial.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# CNBV (fase 8). El timeout es generoso porque el boletín de banca pesa ~15 MB
# y el portal no es rápido. El directorio guarda los archivos crudos —la
# evidencia de cada indicador—; en el VPS apunta al volumen centinela-cnbvdata
# (el compose lo fija a /app/var/cnbv).
# CNBV_TIMEOUT_SECONDS=180
# CNBV_DIRECTORIO_DESCARGAS=var/cnbv

# ─── LLM ──────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.deepseek.com/v1
# Modelo de extracción. NO usar razonadores: gastan el presupuesto de tokens
# pensando y devuelven el contenido vacío. `deepseek-chat` y `deepseek-reasoner`
# los retiró DeepSeek el 2026-07-24.
# LLM_MODELO_EXTRACCION=deepseek-v4-flash
# LLM_TIMEOUT_SECONDS=90
# Techo duro de gasto diario (D2). Es una red contra bucles, no un presupuesto:
# lo esperado son centavos por semana.
# LLM_COST_DAILY_LIMIT_USD=1.0

# ─── Descarga de páginas de tasas ─────────────────────────────
# El bot se identifica y dice dónde reclamar. No se imita un navegador para
# esquivar un WAF: si una institución bloquea a un bot identificado, esa fuente
# pasa a lectura manual. FETCH_RESPETAR_ROBOTS no se pone en false.
# FETCH_USER_AGENT=Mozilla/5.0 (compatible; CentinelaFinancieroBot/1.0; +https://centinelafinanciero.lat/aviso-legal)
# FETCH_RESPETAR_ROBOTS=true
# FETCH_TIMEOUT_SECONDS=20

# Las cuatro capas de resiliencia. Los valores vienen de NarrativeAlpha, donde
# están calibrados en producción — no reducir sin medir.
#   · Reintentos ADEMÁS del intento inicial, y sólo ante errores que el tiempo
#     puede curar (408, 425, 429, 5xx). Un 403 es una decisión, no congestión.
# FETCH_MAX_REINTENTOS=1
#   · Errores duros por host antes de dejarlo para la siguiente corrida.
# FETCH_UMBRAL_CIRCUITO=2
#   · Backoff temporal cuando la cadena se degrada por algo transitorio. Fue
#     de cinco minutos y luego veinte, heredado de una corrida semanal; con el
#     job cada 4 horas la siguiente oportunidad está a 4 horas y el pipeline es
#     secuencial, así que dormir 25 minutos deja el resto de las fuentes
#     esperando. Un host que no conecta ya ni entra aquí.
# FETCH_ESPERAS_BACKOFF_S=[60.0]
#   · Menos texto que esto es una página que no se pudo leer, no una sin tasas.
#     La distinción sostiene el circuito: vacío ≠ error duro.
# FETCH_MIN_CARACTERES=200

# ─── Búsqueda abierta (nivel 3) ───────────────────────────────
# La cadena de motores, en orden: se recorren hasta que uno devuelva algo.
# `ddgs` es un metabuscador de librería —$0, sin llaves ni infraestructura— y
# éstos son sus backends, no servicios propios.
#
# **Aquí es donde se cambia de proveedor sin tocar código.** Si la calibración
# muestra que ddgs no basta, la vía es el SearXNG que ya corre en el VPS, y
# tiene que ser esta variable y no una refactorización. Ver la fase 09.
# RESEARCH_MOTORES=duckduckgo,google,brave
# RESEARCH_MAX_REINTENTOS=1
#   · Vueltas de tool-use antes de retirar las herramientas y exigir el JSON
#     final. Sin tope, un modelo que no converge gasta el presupuesto del día.
# RESEARCH_MAX_RONDAS=4
# RESEARCH_RESULTADOS_POR_BUSQUEDA=6
