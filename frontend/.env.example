# ─── Frontend (BFF) ───────────────────────────────────────────
# Estas variables viven **sólo en el servidor**. Ninguna lleva el prefijo
# PUBLIC_, así que Astro nunca las incluye en el bundle del navegador: es la
# garantía técnica de que la llave de la API no se filtra al cliente.

# La API interna. En compose es el nombre del servicio; en local, el puerto
# publicado en loopback.
API_BASE_URL=http://127.0.0.1:8010

# Llave de **lectura**. Nunca la de admin: el BFF sólo consulta.
API_READ_KEY=

# Segundos que el BFF espera a la API antes de rendirse.
API_TIMEOUT_SECONDS=10

# ─── Público ──────────────────────────────────────────────────
# Con prefijo PUBLIC_ sí llega al navegador. Sólo para lo que no es secreto.
PUBLIC_SITE_URL=http://127.0.0.1:3010
