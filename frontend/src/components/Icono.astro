---
/** Iconos de Lucide, trazo 1.5, sólo los que el diseño usa. */
type Nombre =
  | 'lista'
  | 'calculadora'
  | 'libro'
  | 'escudo'
  | 'escudo-ok'
  | 'alerta'
  | 'chevron'
  | 'flecha-izquierda';

interface Props {
  nombre: Nombre;
  tamano?: number;
  clase?: string;
}

const { nombre, tamano = 16, clase } = Astro.props;

const TRAZOS: Record<Nombre, string> = {
  lista: '<path d="M3 5h18"/><path d="M3 12h18"/><path d="M3 19h18"/>',
  calculadora: '<path d="M12 2v20"/><path d="M2 12h20"/><circle cx="12" cy="12" r="9"/>',
  libro:
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  escudo:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  'escudo-ok':
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  alerta:
    '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  'flecha-izquierda': '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>',
};
---

<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={TRAZOS[nombre]}
/>
