---
/**
 * El aviso que el usuario tiene derecho a ver: esta tasa es de una institución
 * real pero no se pudo confirmar contra su fuente oficial. Va pegado al dato
 * y no en un pie de página porque califica exactamente a ese número.
 *
 * Se sustituye solo: cuando la lectura oficial del producto llega y se
 * aprueba, la fila deja de ser la vigente y la marca desaparece con ella.
 */
interface Props {
  verificada?: boolean;
}
const { verificada = true } = Astro.props;
---

{
  !verificada && (
    <span
      class="marca sin-verificar"
      title="Esta tasa no se ha podido confirmar contra la fuente oficial de la institución"
    >
      sin verificar
    </span>
  )
}

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .sin-verificar {
    padding: 1px 7px;
    border-radius: var(--radio-pastilla);
    font-size: 10px;
    color: var(--aviso);
    background: var(--aviso-fondo);
    white-space: nowrap;
  }
</style>
