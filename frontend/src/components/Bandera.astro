---
/**
 * Una bandera como pastilla.
 *
 * Lleva el tipo escrito, no sólo el color: quien no distingue el amarillo del
 * rojo tiene que poder leer qué pasa. El motivo completo va en `title` y, en
 * el detalle de la institución, en la tarjeta misma.
 *
 * **El periodo del dato va siempre.** §15 obliga a decir de cuándo es la cifra
 * que levantó la bandera, y la CNBV publica con uno a tres meses de rezago: una
 * morosidad de marzo enseñada en agosto sin fecha invita a leerla como de hoy.
 * En la tabla cabe en el `title`; en la ficha se pinta aparte, debajo.
 */
import { periodo } from '~/lib/formato';
import type { Bandera } from '~/lib/tipos';

interface Props {
  bandera: Bandera;
  compacta?: boolean;
}
const { bandera, compacta = false } = Astro.props;

const detalle = bandera.periodo_dato
  ? `${bandera.motivo} (cifras a ${periodo(bandera.periodo_dato)})`
  : bandera.motivo;

const ETIQUETAS: Record<string, string> = {
  IMOR: 'Morosidad',
  ICAP: 'Capitalización',
  NICAP: 'Nivel de capital',
  COBERTURA_CARTERA: 'Cobertura de cartera',
  APALANCAMIENTO: 'Apalancamiento',
  NO_RECOMENDABLE: 'No recomendable',
  // La compuesta de §5.2: tasa muy por encima de la mediana Y morosidad en
  // alerta. La etiqueta cuenta las dos condiciones — «Tasa sobre mercado» a
  // secas hacía parecer incoherente que una institución sana con tasa alta
  // no la llevara, cuando eso es exactamente la regla funcionando.
  RED_FLAG_TASA: 'Tasa alta + morosidad',
  GAT_INCONSISTENTE: 'GAT inconsistente',
  SIN_COBERTURA: 'Sin seguro de depósito',
  TASAS_AMBIGUAS: 'Tasas ambiguas',
};

const etiqueta = ETIQUETAS[bandera.tipo] ?? bandera.tipo;
const roja = bandera.severidad === 'ROJA';
---

<span
  class:list={['pastilla', roja ? 'roja' : 'amarilla', compacta && 'compacta']}
  title={detalle}
>
  <i aria-hidden="true"></i>
  <span class="solo-lectores">Bandera {roja ? 'roja' : 'amarilla'}:</span>
  {etiqueta}
  {
    /* El `title` no llega a un lector de pantalla en una pastilla sin foco,
       así que el periodo se repite en texto oculto: la obligación de §15 no
       puede depender de poder pasar el ratón. */
    bandera.periodo_dato && (
      <span class="solo-lectores">, cifras a {periodo(bandera.periodo_dato)}</span>
    )
  }
</span>

<style>
  .pastilla {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: var(--radio-pastilla);
    font-size: 11px;
    white-space: nowrap;
  }
  .compacta {
    padding: 2px 8px;
    font-size: 10px;
  }
  .pastilla i {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }
  .amarilla {
    color: var(--aviso);
    background: var(--aviso-fondo);
  }
  .roja {
    color: var(--negativo);
    background: var(--negativo-fondo);
  }
</style>
