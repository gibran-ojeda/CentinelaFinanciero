---
/**
 * Los filtros de §7.
 *
 * Es un `<form method="get">` de verdad, no una isla. Sin JavaScript funciona
 * entero —el `<select multiple>` nativo más el botón «Aplicar filtros»— y con
 * JavaScript el script de abajo convierte cada multiselect en el desplegable
 * con casillas del diseño. Las casillas NO envían: sincronizan los `<option>`
 * del select oculto, que sigue siendo el portador del dato, y el formulario
 * se envía al CERRAR el desplegable. Enviar en cada casilla navegaba la
 * página y hacía imposible marcar dos opciones.
 *
 * Esa decisión es la que hace que `/?plazo=91&categoria=SOFIPO` sea una URL
 * indexable con contenido real detrás, en vez de un estado de cliente que
 * Google ve vacío.
 */
import type { FiltrosMercado } from '~/lib/tipos';

interface Props {
  filtros: FiltrosMercado;
  total: number;
}
const { filtros, total } = Astro.props;

const PLAZOS = [
  ['TODOS', 'Todos'],
  ['VISTA', 'A la vista'],
  ['28', '28 días'],
  ['91', '91 días'],
  ['182', '182 días'],
  ['364', '364 días'],
  ['365+', '365 días o más'],
];

/**
 * Sin IFPE este filtro no podía llegar a Mercado Pago; sin BANCO_TRADICIONAL
 * a propósito — cero instituciones en el catálogo, sería un filtro que
 * garantiza vacío. El seguro de depósito ya no es un control: se deriva por
 * completo de la categoría, la columna Cobertura lo dice fila por fila, y el
 * saneador de la página conserva `?seguro=` por las URLs ya indexadas.
 */
const CATEGORIAS = [
  ['GOBIERNO', 'Gobierno'],
  ['BANCO_DIGITAL', 'Banco digital'],
  ['SOFIPO', 'SOFIPO'],
  ['IFPE', 'IFPE (sin seguro)'],
];

const ORDENES = [
  ['ten', 'Mejor TEN'],
  ['tasa_nominal', 'Tasa nominal'],
  ['gat', 'GAT'],
  ['cobertura', 'Cobertura'],
];
---

<form class="filtros" method="get" action="/" data-filtros>
  <div class="campo">
    <label for="f-plazo">Plazo</label>
    <select id="f-plazo" name="plazo" class="control">
      {
        PLAZOS.map(([valor, etiqueta]) => (
          <option value={valor} selected={(filtros.plazo ?? 'TODOS') === valor}>
            {etiqueta}
          </option>
        ))
      }
    </select>
  </div>

  <div class="campo" data-multi="categoria">
    <label for="f-categoria">Categoría</label>
    <select id="f-categoria" name="categoria" class="control" multiple size="4">
      {
        CATEGORIAS.map(([valor, etiqueta]) => (
          <option value={valor} selected={filtros.categorias.includes(valor as never)}>
            {etiqueta}
          </option>
        ))
      }
    </select>
  </div>

  <div class="campo">
    <label for="f-monto">Monto a invertir</label>
    <input
      id="f-monto"
      name="monto"
      class="control"
      type="text"
      inputmode="numeric"
      placeholder="Ej. 10,000"
      value={filtros.monto ?? ''}
      data-miles
    />
  </div>

  <div class="campo">
    <label for="f-orden">Ordenar por</label>
    <select id="f-orden" name="orden" class="control">
      {
        ORDENES.map(([valor, etiqueta]) => (
          <option value={valor} selected={filtros.orden === valor}>
            {etiqueta}
          </option>
        ))
      }
    </select>
  </div>

  <label class="toggle" data-toggle>
    <input type="checkbox" name="sin_banderas" value="true" checked={filtros.sinBanderas} />
    <span>Solo sin banderas</span>
  </label>

  <button type="submit" class="aplicar" data-aplicar>Aplicar filtros</button>
</form>

<p class="conteo etiqueta" aria-live="polite">{total} productos</p>

<script>
  // La mejora progresiva del multiselect. El select nativo queda oculto pero
  // sigue en el formulario y ES el dato: cada casilla sincroniza su <option>,
  // así que el GET produce los mismos `?categoria=…` repetidos de siempre y
  // el saneador del servidor no distingue de dónde vino la petición.
  for (const campo of document.querySelectorAll<HTMLElement>('.campo[data-multi]')) {
    const select = campo.querySelector<HTMLSelectElement>('select[multiple]');
    if (!select) continue;
    const formularioPadre = select.form;
    const opciones = [...select.options];
    const nombre = campo.querySelector('label')?.textContent ?? '';

    const boton = document.createElement('button');
    boton.type = 'button';
    boton.className = 'multi-boton';
    boton.setAttribute('aria-haspopup', 'listbox');
    boton.setAttribute('aria-expanded', 'false');
    const resumen = document.createElement('span');
    resumen.className = 'multi-resumen';
    boton.append(resumen);
    boton.insertAdjacentHTML(
      'beforeend',
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>'
    );

    const panel = document.createElement('div');
    panel.className = 'multi-panel';
    panel.hidden = true;
    panel.setAttribute('role', 'group');
    if (nombre) panel.setAttribute('aria-label', nombre);

    function pintarResumen() {
      const marcadas = opciones.filter((o) => o.selected);
      resumen.textContent =
        marcadas.length === 0
          ? 'Todas'
          : marcadas.length === 1
            ? marcadas[0].text
            : `${marcadas[0].text} +${marcadas.length - 1}`;
    }

    let sucio = false;
    for (const opcion of opciones) {
      const fila = document.createElement('label');
      fila.className = 'multi-opcion';
      const casilla = document.createElement('input');
      casilla.type = 'checkbox';
      casilla.value = opcion.value;
      casilla.checked = opcion.selected;
      casilla.addEventListener('change', () => {
        opcion.selected = casilla.checked;
        sucio = true;
        pintarResumen();
      });
      fila.append(casilla, document.createTextNode(opcion.text));
      panel.append(fila);
    }

    // Enviar al cerrar —click en el botón, click fuera o Escape— y solo si
    // algo cambió: es lo que permite marcar varias casillas en una visita.
    function cerrar() {
      if (panel.hidden) return;
      panel.hidden = true;
      boton.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', alClickFuera, true);
      document.removeEventListener('keydown', alEscape, true);
      if (sucio) {
        sucio = false;
        formularioPadre?.requestSubmit();
      }
    }
    function abrir() {
      panel.hidden = false;
      boton.setAttribute('aria-expanded', 'true');
      document.addEventListener('click', alClickFuera, true);
      document.addEventListener('keydown', alEscape, true);
    }
    const alClickFuera = (evento: MouseEvent) => {
      if (!campo.contains(evento.target as Node)) cerrar();
    };
    const alEscape = (evento: KeyboardEvent) => {
      if (evento.key === 'Escape') {
        cerrar();
        boton.focus();
      }
    };
    boton.addEventListener('click', () => (panel.hidden ? abrir() : cerrar()));

    select.hidden = true;
    select.insertAdjacentElement('afterend', boton);
    boton.insertAdjacentElement('afterend', panel);
    pintarResumen();
  }
</script>

<style>
  .filtros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 4px 0 18px;
    align-items: end;
  }

  .campo label {
    display: block;
    margin-bottom: 5px;
    font-size: 12px;
    color: var(--texto-tenue);
  }

  .control {
    width: 100%;
    min-height: 36px;
    padding: 6px 12px;
    font-size: 14px;
    color: var(--texto);
    background: var(--panel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-campo);
  }
  .control:hover {
    border-color: rgba(167, 224, 219, 0.45);
  }
  select[multiple].control {
    padding: 4px;
  }
  select[multiple].control option {
    padding: 4px 8px;
    border-radius: 6px;
  }

  /* El widget de casillas se construye por JS, así que sus nodos no llevan el
     atributo de scope de Astro: se estilan con :global, anclados al campo. */
  .campo[data-multi] {
    position: relative;
  }
  .campo[data-multi] :global(.multi-boton) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    min-height: 36px;
    padding: 6px 12px;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
    color: var(--texto);
    background: var(--panel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-campo);
    cursor: pointer;
  }
  .campo[data-multi] :global(.multi-boton:hover) {
    border-color: rgba(167, 224, 219, 0.45);
  }
  .campo[data-multi] :global(.multi-boton svg) {
    flex: none;
    opacity: 0.7;
  }
  .campo[data-multi] :global(.multi-panel) {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 230px;
    padding: 6px;
    background: var(--panel);
    border: 1px solid var(--linea-fuerte);
    border-radius: 12px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
  }
  .campo[data-multi] :global(.multi-opcion) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    font-size: 13px;
    color: var(--texto);
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
  }
  .campo[data-multi] :global(.multi-opcion:hover) {
    background: rgba(167, 224, 219, 0.08);
  }
  .campo[data-multi] :global(.multi-opcion input) {
    accent-color: var(--marca-300);
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 7px 15px;
    cursor: pointer;
    border: 1px solid var(--linea);
    border-radius: var(--radio-pastilla);
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 13px;
    color: var(--texto-tenue);
    white-space: nowrap;
  }
  .toggle:hover {
    border-color: var(--linea-fuerte);
  }
  .toggle:has(input:checked) {
    border-color: rgba(95, 176, 201, 0.6);
    background: var(--gradiente-acento);
    color: var(--texto-fuerte);
  }
  .toggle input {
    accent-color: var(--marca-300);
  }

  .aplicar {
    min-height: 36px;
    padding: 7px 16px;
    cursor: pointer;
    border: 1px solid var(--linea);
    border-radius: var(--radio-pastilla);
    background: transparent;
    color: var(--texto);
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 13px;
  }
  .aplicar:hover {
    border-color: var(--linea-fuerte);
  }
  /* Con JavaScript el formulario se envía solo al cambiar cualquier filtro,
     así que el botón sobra. Sin él es imprescindible. */
  :global(html.js) .aplicar {
    display: none;
  }

  .conteo {
    margin: 0 0 12px;
  }

  @media (min-width: 720px) {
    .filtros {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
    }
    .campo {
      min-width: 150px;
    }
  }
</style>
