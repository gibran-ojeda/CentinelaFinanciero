---
/**
 * La tabla del mercado (≥1080px) y las tarjetas debajo.
 *
 * Ambas se renderizan **en servidor**, siempre. Es el criterio de aceptación
 * de la fase: con JavaScript deshabilitado, el comparador muestra la tabla
 * completa con tasas y banderas. Lo único que JavaScript añade es poder
 * seleccionar instrumentos.
 */
import Avatar from '~/components/Avatar.astro';
import Bandera from '~/components/Bandera.astro';
import BotonAgregar from '~/components/BotonAgregar.astro';
import FechaDato from '~/components/FechaDato.astro';
import { montoCorto, plazoCorto, plazoLargo, porcentaje, tramoEtiqueta } from '~/lib/formato';
import type { FilaComparador } from '~/lib/tipos';

interface Props {
  filas: FilaComparador[];
  /** Si la petición traía filtros: cambia el mensaje del estado vacío. */
  hayFiltros?: boolean;
  /** El monto consultado: con él, las columnas pasan a la tasa efectiva. */
  monto?: string | null;
}
const { filas, hayFiltros = false, monto = null } = Astro.props;

/**
 * Con monto consultado, la cifra es la efectiva de ESE monto — un «13%
 * hasta $30 mil» no puede presumirle 13% a quien invierte medio millón. Sin
 * monto, la titular (el primer tramo), con su marca de alcance al lado.
 */
function tasaMostrada(fila: FilaComparador): string {
  return monto ? (fila.tasa_efectiva ?? fila.tasa_nominal) : fila.tasa_nominal;
}
function marcaTramo(fila: FilaComparador): string | null {
  if (!fila.escalonada) return null;
  if (monto) return `efectiva a ${montoCorto(monto)}`;
  const primero = fila.tramos[0];
  return primero?.hasta ? `hasta ${montoCorto(primero.hasta)}` : null;
}
function escaleraTexto(fila: FilaComparador): string {
  return fila.tramos
    .map((tramo) => `${porcentaje(tramo.tasa_nominal)} ${tramoEtiqueta(tramo.hasta)}`)
    .join(' · ');
}
---

{
  /* Dos vacíos distintos: con filtros, el usuario los apretó de más; sin
     ellos, el catálogo aún no tiene tasas publicables — decir «amplía el
     plazo» ahí sería culpar al usuario de un estado del sistema. */
  filas.length === 0 && (
    <p class="vacio">
      {hayFiltros
        ? 'Ningún instrumento cumple estos filtros. Prueba a ampliar el plazo o a bajar el monto.'
        : 'Aún no hay tasas publicables que mostrar. El catálogo se llena conforme se verifica cada lectura.'}
    </p>
  )
}

<!-- Tabla: escritorio -->
<div class="envoltorio-tabla">
  <div class="tabla" role="table" aria-label="Comparador de instrumentos de ahorro">
    <div class="cabecera-tabla" role="row">
      <span role="columnheader"><span class="solo-lectores">Agregar</span></span>
      <span role="columnheader">Institución</span>
      <span role="columnheader">Producto</span>
      <span role="columnheader">Plazo</span>
      <span role="columnheader" class="der">Nominal</span>
      <span role="columnheader">Banderas</span>
      <span role="columnheader">Dato al</span>
    </div>

    {
      filas.map((fila) => (
        <div class="fila" role="row">
          <BotonAgregar
            productoId={fila.producto_id}
            institucion={fila.institucion.nombre}
            producto={fila.producto}
            slug={fila.producto_slug}
          />
          <a class="celda-institucion" href={`/institucion/${fila.institucion.slug}`} role="cell">
            <Avatar nombre={fila.institucion.nombre} slug={fila.institucion.slug} tamano={28} />
            <span class="nombre">{fila.institucion.nombre}</span>
          </a>
          <span class="producto tenue" role="cell">
            {fila.producto}
            {fila.escalonada && <span class="escalera tenue-2">{escaleraTexto(fila)}</span>}
            {fila.condiciones && (
              <span class="condiciones tenue-2" title={fila.condiciones}>{fila.condiciones}</span>
            )}
          </span>
          <span class="tenue" role="cell">
            {plazoCorto(fila.plazo_dias, fila.tipo)}
          </span>
          <span class="der num" role="cell">
            {porcentaje(tasaMostrada(fila))}
            {fila.escalonada && <span class="marca-tramo tenue-2">{marcaTramo(fila)}</span>}
          </span>
          <span class="banderas" role="cell">
            {fila.banderas.map((bandera) => (
              <Bandera bandera={bandera} compacta />
            ))}
            {fila.banderas.length === 0 && <span class="tenue-2">—</span>}
          </span>
          <span class="fecha" role="cell">
            <FechaDato procedencia={fila.procedencia} />
          </span>
        </div>
      ))
    }
  </div>
</div>

<!-- Tarjetas: móvil y tablet -->
<div class="tarjetas">
  {
    filas.map((fila) => (
      <article class="tarjeta">
        <div class="tarjeta-cabecera">
          <Avatar nombre={fila.institucion.nombre} slug={fila.institucion.slug} tamano={38} />
          <a class="tarjeta-titulo" href={`/institucion/${fila.institucion.slug}`}>
            <span class="nombre">{fila.institucion.nombre}</span>
            <span class="tenue sub">
              {fila.producto} · {plazoLargo(fila.plazo_dias, fila.tipo)}
            </span>
          </a>
          <BotonAgregar
            productoId={fila.producto_id}
            institucion={fila.institucion.nombre}
            producto={fila.producto}
            slug={fila.producto_slug}
          />
        </div>

        {fila.banderas.length > 0 && (
          <div class="tarjeta-banderas">
            {fila.banderas.map((bandera) => (
              <Bandera bandera={bandera} />
            ))}
          </div>
        )}

        <div class="tarjeta-cifras">
          <div>
            <div class="etiqueta-cifra">Tasa</div>
            <div class="cifra grande">{porcentaje(tasaMostrada(fila))}</div>
            {fila.escalonada && <div class="marca-tramo tenue-2">{marcaTramo(fila)}</div>}
          </div>
        </div>

        {fila.escalonada && <div class="escalera-tarjeta tenue-2">{escaleraTexto(fila)}</div>}
        {fila.condiciones && <div class="escalera-tarjeta tenue-2">{fila.condiciones}</div>}

        <div class="tarjeta-pie">
          <FechaDato procedencia={fila.procedencia} prefijo="dato al" />
        </div>
      </article>
    ))
  }
</div>

<style>
  .vacio {
    padding: 28px 18px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    color: var(--texto-tenue);
    text-align: center;
  }

  /* ── Tabla ── */
  .envoltorio-tabla {
    display: none;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    box-shadow: var(--sombra-md);
  }
  .tabla {
    --cols: 46px 1.5fr 1.9fr 0.55fr 0.85fr 1.2fr 0.75fr;
  }
  .cabecera-tabla,
  .fila {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 10px;
    align-items: center;
  }
  .cabecera-tabla {
    padding: 12px 18px;
    border-bottom: 1px solid var(--linea);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-tenue-2);
  }
  .fila {
    padding: 10px 18px;
    border-bottom: 1px solid var(--linea-suave);
    font-size: 14px;
  }
  .fila:hover {
    background: var(--acento-fondo);
  }

  .celda-institucion {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .celda-institucion .nombre {
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 15px;
    color: var(--texto-fuerte);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .celda-institucion:hover .nombre {
    color: var(--marca-200);
  }
  .producto {
    font-size: 13px;
  }
  .escalera {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.35;
  }
  /* La letra pequeña de la tasa. Se corta a tres líneas: es texto de longitud
     libre que escribe cada institución, y una promoción de cinco renglones
     estiraría su fila y descuadraría la tabla entera. Completa en el `title`. */
  .condiciones {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .marca-tramo {
    display: block;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.3;
    white-space: nowrap;
  }
  .escalera-tarjeta {
    margin-top: 10px;
    font-size: 11px;
  }
  .der {
    text-align: right;
  }
  .banderas {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .fecha {
    font-size: 12px;
  }

  /* ── Tarjetas ── */
  .tarjetas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .tarjeta {
    padding: 16px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    box-shadow: var(--sombra-md);
  }
  .tarjeta-cabecera {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-bottom: 10px;
  }
  .tarjeta-titulo {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .tarjeta-titulo .nombre {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.15;
    color: var(--texto-fuerte);
  }
  .sub {
    display: block;
    font-size: 12px;
  }
  .tarjeta-banderas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .tarjeta-cifras {
    padding-top: 10px;
    border-top: 1px solid var(--linea);
  }
  .etiqueta-cifra {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-tenue-2);
  }
  .grande {
    font-size: 25px;
    color: var(--texto-fuerte);
  }
  .tarjeta-pie {
    margin-top: 10px;
    font-size: 11px;
  }

  @media (min-width: 720px) {
    .tarjetas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .envoltorio-tabla {
      display: block;
    }
    .tarjetas {
      display: none;
    }
  }
</style>
