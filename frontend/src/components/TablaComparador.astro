---
/**
 * La tabla del mercado (≥1080px) y las tarjetas debajo.
 *
 * Ambas se renderizan **en servidor**, siempre. Es el criterio de aceptación
 * de la fase: con JavaScript deshabilitado, el comparador muestra la tabla
 * completa con tasas y banderas. Lo único que JavaScript añade es poder
 * seleccionar instrumentos.
 */
import Avatar from '~/components/Avatar.astro';
import Bandera from '~/components/Bandera.astro';
import BotonAgregar from '~/components/BotonAgregar.astro';
import MarcaDato from '~/components/MarcaDato.astro';
import { fecha, plazoCorto, plazoLargo, porcentaje } from '~/lib/formato';
import type { FilaComparador } from '~/lib/tipos';

interface Props {
  filas: FilaComparador[];
}
const { filas } = Astro.props;

const ETIQUETA_SEGURO: Record<string, string> = {
  SOBERANO: 'Soberano',
  IPAB: 'IPAB',
  PROSOFIPO: 'PROSOFIPO',
  NINGUNO: 'Sin cobertura',
};

function coberturaCorta(fila: FilaComparador): string {
  const { cobertura } = fila;
  if (cobertura.sin_limite) return 'Sin límite';
  if (cobertura.sin_cobertura) return 'Sin protección';
  const n = Number(cobertura.limite_mxn);
  return n >= 1_000_000 ? `$${(n / 1_000_000).toFixed(2)} M` : `$${Math.round(n / 1_000)} mil`;
}
---

{
  filas.length === 0 && (
    <p class="vacio">
      Ningún instrumento cumple estos filtros. Prueba a ampliar el plazo o a bajar el monto.
    </p>
  )
}

<!-- Tabla: escritorio -->
<div class="envoltorio-tabla">
  <div class="tabla" role="table" aria-label="Comparador de instrumentos de ahorro">
    <div class="cabecera-tabla" role="row">
      <span role="columnheader"><span class="solo-lectores">Agregar</span></span>
      <span role="columnheader">Institución</span>
      <span role="columnheader">Producto</span>
      <span role="columnheader">Plazo</span>
      <span role="columnheader" class="der">Nominal</span>
      <span role="columnheader" class="der acento">TEN</span>
      <span role="columnheader" class="der">GAT</span>
      <span role="columnheader">Cobertura</span>
      <span role="columnheader">Banderas</span>
      <span role="columnheader">Dato al</span>
    </div>

    {
      filas.map((fila) => (
        <div class="fila" role="row">
          <BotonAgregar
            productoId={fila.producto_id}
            institucion={fila.institucion.nombre}
            producto={fila.producto}
            slug={fila.producto_slug}
          />
          <a class="celda-institucion" href={`/institucion/${fila.institucion.slug}`} role="cell">
            <Avatar nombre={fila.institucion.nombre} slug={fila.institucion.slug} tamano={28} />
            <span class="nombre">{fila.institucion.nombre}</span>
            <MarcaDato esDemostracion={fila.institucion.es_demostracion} />
          </a>
          <span class="producto tenue" role="cell">
            {fila.producto}
          </span>
          <span class="tenue" role="cell">
            {plazoCorto(fila.plazo_dias, fila.tipo)}
          </span>
          <span class="der num" role="cell">
            {porcentaje(fila.tasa_nominal)}
          </span>
          <span class="der ten cifra" role="cell">
            {porcentaje(fila.ten)}
          </span>
          <span class="der num" role="cell">
            {porcentaje(fila.gat.nominal)}
            {fila.gat.es_calculada && <span class="equiv tenue-2">(equiv.)</span>}
          </span>
          <span class="cobertura tenue" role="cell">
            {ETIQUETA_SEGURO[fila.cobertura.tipo]} · {coberturaCorta(fila)}
          </span>
          <span class="banderas" role="cell">
            {fila.banderas.map((bandera) => (
              <Bandera bandera={bandera} compacta />
            ))}
            {fila.banderas.length === 0 && <span class="tenue-2">—</span>}
          </span>
          <span class="fecha tenue-2" role="cell">
            {/*
              La fecha enlaza a la página de la que se leyó la tasa. No añade
              columna ni cambia el layout: es el mismo texto, con destino.
            */}
            {fila.procedencia.fuente_url ? (
              <a
                href={fila.procedencia.fuente_url}
                target="_blank"
                rel="nofollow noopener"
                title={`Ver esta tasa en la fuente (${fila.procedencia.fuente})`}
              >
                {fecha(fila.procedencia.fecha_dato)}
              </a>
            ) : (
              fecha(fila.procedencia.fecha_dato)
            )}
            <MarcaDato verificada={fila.procedencia.verificada} />
          </span>
        </div>
      ))
    }
  </div>
</div>

<!-- Tarjetas: móvil y tablet -->
<div class="tarjetas">
  {
    filas.map((fila) => (
      <article class="tarjeta">
        <div class="tarjeta-cabecera">
          <Avatar nombre={fila.institucion.nombre} slug={fila.institucion.slug} tamano={38} />
          <a class="tarjeta-titulo" href={`/institucion/${fila.institucion.slug}`}>
            <span class="nombre">
              {fila.institucion.nombre}
              <MarcaDato esDemostracion={fila.institucion.es_demostracion} />
            </span>
            <span class="tenue sub">
              {fila.producto} · {plazoLargo(fila.plazo_dias, fila.tipo)}
            </span>
          </a>
          <BotonAgregar
            productoId={fila.producto_id}
            institucion={fila.institucion.nombre}
            producto={fila.producto}
            slug={fila.producto_slug}
          />
        </div>

        {fila.banderas.length > 0 && (
          <div class="tarjeta-banderas">
            {fila.banderas.map((bandera) => (
              <Bandera bandera={bandera} />
            ))}
          </div>
        )}

        <div class="tarjeta-cifras">
          <div>
            <div class="etiqueta-cifra">TEN</div>
            <div class="cifra grande ten">{porcentaje(fila.ten)}</div>
          </div>
          <div>
            <div class="etiqueta-cifra">Nominal</div>
            <div class="cifra grande">{porcentaje(fila.tasa_nominal)}</div>
          </div>
          <div>
            <div class="etiqueta-cifra">GAT</div>
            <div class="cifra grande">
              {porcentaje(fila.gat.nominal)}
              {fila.gat.es_calculada && <span class="equiv tenue-2">(equiv.)</span>}
            </div>
          </div>
        </div>

        <div class="tarjeta-pie">
          <span class="tenue">
            {ETIQUETA_SEGURO[fila.cobertura.tipo]} · {coberturaCorta(fila)}
          </span>
          <span class="tenue-2 tarjeta-fecha">
            dato:{' '}
            {fila.procedencia.fuente_url ? (
              <a
                href={fila.procedencia.fuente_url}
                target="_blank"
                rel="nofollow noopener"
                title={`Ver esta tasa en la fuente (${fila.procedencia.fuente})`}
              >
                {fecha(fila.procedencia.fecha_dato)}
              </a>
            ) : (
              fecha(fila.procedencia.fecha_dato)
            )}
            <MarcaDato verificada={fila.procedencia.verificada} />
          </span>
        </div>
      </article>
    ))
  }
</div>

<style>
  .vacio {
    padding: 28px 18px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    color: var(--texto-tenue);
    text-align: center;
  }

  /* ── Tabla ── */
  .envoltorio-tabla {
    display: none;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    box-shadow: var(--sombra-md);
  }
  .tabla {
    --cols: 46px 1.4fr 1.35fr 0.55fr 0.75fr 0.75fr 0.95fr 1.05fr 1.15fr 0.7fr;
  }
  .cabecera-tabla,
  .fila {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 10px;
    align-items: center;
  }
  .cabecera-tabla {
    padding: 12px 18px;
    border-bottom: 1px solid var(--linea);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-tenue-2);
  }
  .fila {
    padding: 10px 18px;
    border-bottom: 1px solid var(--linea-suave);
    font-size: 14px;
  }
  .fila:hover {
    background: var(--acento-fondo);
  }

  .celda-institucion {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .celda-institucion .nombre {
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 15px;
    color: var(--texto-fuerte);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .celda-institucion:hover .nombre {
    color: var(--marca-200);
  }
  .producto {
    font-size: 13px;
  }
  .der {
    text-align: right;
  }
  .acento {
    color: var(--marca-200);
  }
  .ten {
    color: var(--positivo);
  }
  .fila .ten {
    font-size: 15px;
  }
  .equiv {
    font-size: 10px;
    font-weight: 400;
  }
  .cobertura {
    font-size: 12px;
  }
  .banderas {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .fecha {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: flex-start;
    font-size: 12px;
  }
  /* Enlace discreto: subrayado punteado en vez de color, para no competir con
     los datos de la fila. Se declara el color en :hover y no antes. */
  .fecha a,
  .tarjeta-fecha a {
    color: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 2px;
  }
  .fecha a:hover,
  .tarjeta-fecha a:hover,
  .fecha a:focus-visible,
  .tarjeta-fecha a:focus-visible {
    color: var(--marca-200);
  }

  /* ── Tarjetas ── */
  .tarjetas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .tarjeta {
    padding: 16px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-panel);
    box-shadow: var(--sombra-md);
  }
  .tarjeta-cabecera {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-bottom: 10px;
  }
  .tarjeta-titulo {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .tarjeta-titulo .nombre {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.15;
    color: var(--texto-fuerte);
  }
  .sub {
    display: block;
    font-size: 12px;
  }
  .tarjeta-banderas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .tarjeta-cifras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--linea);
  }
  .etiqueta-cifra {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-tenue-2);
  }
  .grande {
    font-size: 25px;
    color: var(--texto-fuerte);
  }
  .tarjeta-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    font-size: 11px;
  }
  .tarjeta-fecha {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (min-width: 720px) {
    .tarjetas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .envoltorio-tabla {
      display: block;
    }
    .tarjetas {
      display: none;
    }
  }
</style>
