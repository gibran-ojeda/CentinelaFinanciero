---
/**
 * Cabecera fija, pie, y navegación inferior en móvil.
 *
 * El `<slot>` es toda la página. Lo único que hidrata desde aquí es la píldora
 * flotante de selección, y sólo por debajo de 720px — en escritorio la barra
 * "Tu selección" vive dentro del mercado, donde el diseño la coloca.
 */
import Icono from '~/components/Icono.astro';
import Logo from '~/components/Logo.astro';
import { urlCanonica } from '~/lib/sitio';
import '~/styles/tokens.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** `legal` no casa con ninguna pestaña: esas páginas viven en el pie. */
  vista: 'mercado' | 'calculadora' | 'metodologia' | 'institucion' | 'legal';
  canonica?: string;
  jsonLd?: unknown;
}

const { titulo, descripcion, vista, canonica, jsonLd } = Astro.props;

const canonicaFinal = canonica ?? urlCanonica(Astro.url);

const ENLACES = [
  { href: '/', etiqueta: 'Mercado', vista: 'mercado', icono: 'lista' as const },
  { href: '/calculadora', etiqueta: 'Calculadora', vista: 'calculadora', icono: 'calculadora' as const },
  { href: '/metodologia', etiqueta: 'Metodología', vista: 'metodologia', icono: 'libro' as const },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonicaFinal} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Centinela Financiero" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonicaFinal} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      /* `is:inline` porque no es un script a procesar sino datos para los
         buscadores: pasarlo por el bundler lo sacaría del <head>. */
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>

  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>

    <header class="cabecera">
      <div class="cabecera-interior">
        <a href="/" class="marca">
          <span class="marca-cuadro"><Logo tamano={20} /></span>
          CENTINELA FINANCIERO
        </a>
        <nav class="enlaces" aria-label="Principal">
          {
            ENLACES.map((enlace) => (
              <a
                href={enlace.href}
                aria-current={vista === enlace.vista ? 'page' : undefined}
              >
                {enlace.etiqueta}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="contenido" class="principal"><slot /></main>

    <footer class="pie">
      <div class="pie-interior">
        <div>
          <div class="pie-marca">
            <Logo tamano={18} />
            CENTINELA FINANCIERO
          </div>
          <p class="tenue-2 pie-texto">
            Comparador informativo de instrumentos de ahorro en México. No es asesoría de
            inversión, no intermedia contrataciones y no cobra a las instituciones listadas.
          </p>
        </div>
        <nav class="pie-enlaces" aria-label="Secundaria">
          <a href="/metodologia">Metodología</a>
          <a href="/metodologia#banderas">Banderas de salud</a>
          <a href="/aviso-legal">Aviso legal</a>
          <a href="/privacidad">Privacidad</a>
        </nav>
        <p class="tenue-2 pie-fuentes">
          Fuentes: Banco de México y CNBV, complementadas con verificación manual. Cada tasa
          muestra su fecha de actualización y su fuente.
        </p>
      </div>
    </footer>

    <nav class="nav-inferior" aria-label="Principal (móvil)">
      {
        ENLACES.map((enlace) => (
          <a href={enlace.href} aria-current={vista === enlace.vista ? 'page' : undefined}>
            <Icono nombre={enlace.icono} tamano={20} />
            {enlace.etiqueta === 'Metodología' ? 'Método' : enlace.etiqueta}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--panel-2);
    border-radius: var(--radio-campo);
  }
  .saltar:focus {
    left: 12px;
    top: 12px;
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cabecera);
    border-bottom: 1px solid var(--linea);
    backdrop-filter: blur(10px);
  }
  .cabecera-interior {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 1420px;
    margin: 0 auto;
    padding: 12px 16px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-right: auto;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.02em;
    color: var(--texto-fuerte);
    text-decoration: none;
  }
  .marca-cuadro {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    color: var(--marca-100);
    background: var(--gradiente-marca);
    box-shadow: var(--sombra-sm);
  }

  .enlaces {
    display: none;
    gap: 24px;
    align-items: center;
    font-size: 14px;
  }
  .enlaces a {
    color: var(--texto-tenue);
    text-decoration: none;
  }
  .enlaces a:hover,
  .enlaces a[aria-current='page'] {
    color: var(--texto-fuerte);
  }

  .principal {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    /* El padding inferior deja sitio a la nav fija y a la píldora de
       selección, que flota justo encima de ella. */
    padding: 18px 16px 150px;
  }

  .pie {
    border-top: 1px solid var(--linea);
    background: rgba(10, 12, 34, 0.5);
  }
  .pie-interior {
    display: grid;
    gap: 14px;
    max-width: 1420px;
    margin: 0 auto;
    padding: 22px 16px 100px;
  }
  .pie-marca {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 16px;
    color: var(--texto-fuerte);
  }
  .pie-marca :global(svg) {
    color: var(--marca-200);
  }
  .pie-texto,
  .pie-fuentes {
    max-width: 52ch;
    margin: 0;
    font-size: 12px;
  }
  .pie-enlaces {
    display: grid;
    gap: 5px;
    font-size: 13px;
  }

  .nav-inferior {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: flex;
    background: rgba(16, 18, 48, 0.92);
    border-top: 1px solid var(--linea);
    backdrop-filter: blur(10px);
  }
  .nav-inferior a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    /* 44px de alto mínimo: el objetivo táctil que pide el handoff. */
    min-height: 44px;
    padding: 10px 0 12px;
    font-family: var(--fuente-titulo);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--texto-tenue);
    text-decoration: none;
  }
  .nav-inferior a[aria-current='page'] {
    color: var(--texto-fuerte);
  }

  @media (min-width: 720px) {
    .principal {
      max-width: 960px;
      padding: 26px 32px 70px;
    }
    .enlaces {
      display: flex;
    }
    .nav-inferior {
      display: none;
    }
    .pie-interior {
      grid-template-columns: 2fr 1fr 1fr;
      padding-bottom: 22px;
    }
  }

  @media (min-width: 1080px) {
    .principal {
      max-width: 1220px;
    }
  }

  /* 2K y 4K: el handoff pide escalar el conjunto, no rediseñar. */
  @media (min-width: 1600px) {
    .principal {
      max-width: 1340px;
      zoom: 1.12;
    }
  }
  @media (min-width: 2400px) {
    .principal {
      max-width: 1420px;
      zoom: 1.55;
    }
  }
</style>
